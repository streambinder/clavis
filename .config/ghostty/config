window-padding-x = 12
window-padding-y = 12

# disable vsync cap — renders as fast as the GPU allows, lower input latency
window-vsync = false

# let Metal handle blending natively, no extra passes
alpha-blending = native

# auto-switch colors with system dark/light mode
theme = light:iTerm2 Solarized Light,dark:iTerm2 Solarized Dark
