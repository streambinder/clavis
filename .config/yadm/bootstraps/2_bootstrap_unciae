#!/bin/bash

set -euo pipefail

cd "${HOME}"

# strip caller venv: loop spans many projects, each with own .venv
unset VIRTUAL_ENV

echo "Syncing unciae submodule..."
yadm submodule update --init --recursive .local/share/unciae

PI_SKILLS="${HOME}/.pi/agent/skills"
PI_EXTENSIONS="${HOME}/.pi/agent/extensions"
mkdir -p "${PI_SKILLS}" "${PI_EXTENSIONS}"

echo "Deleting broken symlinks..."
find -L .local/bin "${PI_SKILLS}" "${PI_EXTENSIONS}" -maxdepth 1 -type l -print -exec rm -f {} +

# pi_extensions entrypoints are main.ts, which this loop would otherwise try to
# link into .local/bin as if they were tools
echo "Linking existing tools..."
find .local/share/unciae -type f -name "main.*" -not -path '*/.venv/*' -not -path '*/__pycache__/*' -not -path '*/pi_extensions/*' | while read -r fname; do
	# file name: .local/share/unciae/category/uncia/main.sh
	fname_bin="$(awk -F/ '{print $(NF-1)}' <<<"${fname}")" # script name: uncia
	fname_bin_rel="${fname/.local/..}"                     # path relative to .local/bin: ../share/unciae/category/uncia/main.sh
	fname_bin_path=".local/bin/${fname_bin}"               # script target path: .local/bin/uncia
	fname_bin_parent="$(dirname "${fname}")"               # script directory: .local/share/unciae/category/uncia
	fname_abs="$(realpath "${fname}")"                     # absolute path to the script: /home/$USER/.local/share/unciae/category/uncia/main.sh
	rm -f "${fname_bin_path}"
	case "${fname##*.}" in
	sh)
		echo "Linking shell script ${fname_bin} at ${fname_bin_path}"
		ln -sf "${fname_bin_rel}" "${fname_bin_path}"
		;;
	py)
		fname_pyproject="${fname_bin_parent}/pyproject.toml"
		if [ ! -f "${fname_pyproject}" ]; then
			echo "ERROR: ${fname_bin} missing pyproject.toml at ${fname_bin_parent} (per unciae/ai/README.md §21.10)" >&2
			exit 1
		fi
		fname_parent_abs="$(realpath "${fname_bin_parent}")"
		echo "Provisioning Python script ${fname_bin} via uv at ${fname_bin_path}"
		uv sync --frozen --project "${fname_parent_abs}"
		cat >"${fname_bin_path}" <<-EOF
			#!/bin/bash
			exec env -u VIRTUAL_ENV uv --project "${fname_parent_abs}" run --frozen python "${fname_abs}" "\$@"
		EOF
		chmod a+x "${fname_bin_path}"
		# pre-compile bytecode for faster cold-start
		uv --project "${fname_parent_abs}" run --frozen python -m compileall -q "${fname_parent_abs}" >/dev/null 2>&1 || echo "${fname_bin} compileall failed"
		;;
	go)
		echo "Building Go script ${fname_bin} at ${fname_bin_path}"
		cd "${fname_bin_parent}"
		go build
		cd - >/dev/null
		mv "${fname_bin_parent}/${fname_bin}" "${fname_bin_path}"
		;;
	esac
	[ -e "${fname_bin_path}" ] && chmod a+x "${fname_bin_path}"
done

echo "Bootstrapping Pi skills..."
if [ -d ".local/share/unciae/pi_skills" ]; then
	find .local/share/unciae/pi_skills -name 'README.md' | while read -r fname; do
		skill_name="$(basename "$(dirname "${fname}")")"
		echo "Linking skill ${skill_name} at ${PI_SKILLS}/${skill_name}.md"
		ln -sf "$(realpath "${fname}")" "${PI_SKILLS}/${skill_name}.md"
	done
fi

echo "Bootstrapping Pi extensions..."
if [ -d ".local/share/unciae/pi_extensions" ]; then
	# pi discovers extensions/*.ts and extensions/*/index.ts, so the flat form is
	# what lets the repo keep naming its entrypoints main.ts like every other tool
	find .local/share/unciae/pi_extensions -name 'main.ts' | while read -r fname; do
		extension_name="$(basename "$(dirname "${fname}")")"
		echo "Linking extension ${extension_name} at ${PI_EXTENSIONS}/${extension_name}.ts"
		ln -sf "$(realpath "${fname}")" "${PI_EXTENSIONS}/${extension_name}.ts"
	done
fi
